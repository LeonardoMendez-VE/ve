<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIPT</title>
    <meta
      name="description"
      content="Open-source ecommerce website template built with HTML and CSS."
    />
    <style>
      :root {
        --bg: #f5f7fb;
        --card: #ffffff;
        --card-alt: #f0f3ff;
        --primary: #4f46e5;
        --primary-dark: #3730a3;
        --accent: #ff7a59;
        --text: #1f2937;
        --muted: #6b7280;
        --border: #e5e7eb;
        --success: #10b981;
        --shadow: 0 18px 45px rgba(79, 70, 229, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      button {
        font: inherit;
        cursor: pointer;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        background: #111827;
        color: #f9fafb;
        font-size: 0.85rem;
      }

      .topbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 12px 0;
      }

      .topbar-links {
        display: flex;
        gap: 20px;
        opacity: 0.9;
      }

      .header {
        background: rgba(255, 255, 255, 0.9);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(10px);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 82px;
        gap: 24px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 1.5rem;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--primary), #7c3aed);
        color: white;
        display: grid;
        place-items: center;
        box-shadow: var(--shadow);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        color: var(--muted);
        font-weight: 600;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 14px;
      }


      .icon-button,
      .primary-btn,
      .secondary-btn,
      .ghost-btn {
        border: none;
        transition: 0.2s ease;
      }

      .icon-button {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #f3f4f6;
        color: var(--text);
        font-size: 1.1rem;
      }

      .primary-btn,
      .secondary-btn,
      .ghost-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 12px;
        font-weight: 700;
      }

      .primary-btn {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: var(--shadow);
      }

      .secondary-btn {
        background: #eef2ff;
        color: var(--primary-dark);
      }

      .ghost-btn {
        background: white;
        border: 1px solid var(--border);
        color: var(--text);
      }

      .primary-btn:hover,
      .secondary-btn:hover,
      .ghost-btn:hover,
      .icon-button:hover {
        transform: translateY(-1px);
      }

      .hero {
        padding: 64px 0 42px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 38px;
        align-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #eef2ff;
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 8px 12px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      h1 {
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: 1;
        margin: 18px 0 18px;
        letter-spacing: -0.06em;
      }

      .lead {
        color: var(--muted);
        font-size: 1.1rem;
        line-height: 1.7;
        max-width: 620px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 28px;
      }

      .hero-meta {
        display: flex;
        gap: 22px;
        flex-wrap: wrap;
        margin-top: 30px;
      }

      .hero-stat {
        min-width: 110px;
      }

      .hero-stat strong {
        display: block;
        font-size: 1.5rem;
      }

      .hero-stat span {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .hero-visual {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .phone-card {
        width: min(100%, 430px);
        background: linear-gradient(180deg, #ffffff, #eef2ff);
        border: 1px solid rgba(79, 70, 229, 0.08);
        border-radius: 32px;
        padding: 18px;
        box-shadow: var(--shadow);
        position: relative;
      }

      .product-spotlight {
        background: linear-gradient(135deg, #eef2ff, #faf5ff);
        border-radius: 24px;
        padding: 16px;
      }

      .spotlight-image {
        background: linear-gradient(135deg, #dfe7ff, #c7d2fe);
        border-radius: 20px;
        height: 300px;
        position: relative;
        overflow: hidden;
      }

      .shoe-illustration {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
      }

      .shoe-illustration::before {
        content: "";
        width: 230px;
        height: 120px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        border-radius: 50% 45% 38% 42% / 60% 55% 45% 40%;
        transform: rotate(-12deg);
        box-shadow: 0 30px 25px rgba(79, 70, 229, 0.18);
      }

      .spotlight-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 18px 10px 8px;
      }

      .badge {
        display: inline-block;
        background: #dcfce7;
        color: #166534;
        font-weight: 700;
        padding: 8px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
      }

      .floating-card {
        position: absolute;
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 12px 16px;
        box-shadow: 0 20px 40px rgba(17, 24, 39, 0.12);
      }

      .floating-card.small {
        right: -18px;
        top: 70px;
      }

      .floating-card.large {
        left: -22px;
        bottom: 30px;
      }

      .floating-card strong {
        font-size: 1.35rem;
      }

      .floating-card span {
        color: var(--muted);
        font-size: 0.8rem;
      }

      .section {
        padding: 72px 0;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 16px;
        margin-bottom: 28px;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(2rem, 3vw, 2.8rem);
        letter-spacing: -0.05em;
      }

      .muted {
        color: var(--muted);
      }

      .categories {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
      }

      .category-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.04);
      }

      .category-art {
        height: 170px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #eef2ff, #f5f3ff);
        font-size: 3rem;
      }

      .category-copy {
        padding: 18px 18px 22px;
      }

      .category-name {
        margin: 0 0 8px;
        font-size: 1.2rem;
      }

      .category-copy p {
        margin: 0;
        color: var(--muted);
      }

      .products {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
      }

      .product-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 14px;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.04);
      }

      .product-image {
        border-radius: 18px;
        height: 220px;
        background: linear-gradient(135deg, #f3f4f6, #e0e7ff);
        position: relative;
        overflow: hidden;
        display: grid;
        place-items: center;
      }

      .product-image::before {
        content: "";
        width: 160px;
        height: 90px;
        background: linear-gradient(135deg, #4f46e5, #8b5cf6);
        border-radius: 46% 54% 42% 58% / 60% 40% 60% 40%;
        transform: rotate(-12deg);
        box-shadow: 0 20px 18px rgba(79, 70, 229, 0.18);
      }

      .product-image.alt1::before {
        background: linear-gradient(135deg, #fb7185, #f97316);
      }

      .product-image.alt2::before {
        background: linear-gradient(135deg, #10b981, #22c55e);
      }

      .product-image.alt3::before {
        background: linear-gradient(135deg, #f59e0b, #ef4444);
      }

      .tag {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(255, 255, 255, 0.9);
        color: var(--text);
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 0.75rem;
        font-weight: 700;
      }

      .product-body {
        padding: 16px 8px 8px;
      }

      .rating {
        color: #f59e0b;
        font-size: 0.9rem;
        margin-bottom: 8px;
      }

      .product-name {
        margin: 0 0 8px;
        font-size: 1.15rem;
      }

      .product-price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
      }

      .price {
        font-size: 1.5rem;
        font-weight: 800;
      }

      .discount {
        color: var(--success);
        font-weight: 700;
      }

      .deal-banner {
        background: linear-gradient(135deg, #111827, #1f2937);
        color: white;
        border-radius: 28px;
        padding: 34px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 26px;
      }

      .deal-banner h3 {
        font-size: clamp(1.8rem, 3vw, 3rem);
        margin: 0 0 12px;
        letter-spacing: -0.06em;
      }

      .deal-banner p {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
        max-width: 620px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .stat-box {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 28px;
        text-align: center;
      }

      .stat-box strong {
        display: block;
        font-size: clamp(2rem, 3vw, 3rem);
        margin-bottom: 8px;
      }

      .testimonials {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .testimonial {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 24px;
      }

      .stars {
        color: #f59e0b;
        letter-spacing: 0.15em;
        margin-bottom: 18px;
      }

      .testimonial p {
        color: var(--muted);
        line-height: 1.7;
        margin: 0 0 20px;
      }

      .person {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .avatar {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #c7d2fe, #fbcfe8);
        border-radius: 50%;
      }

      .newsletter {
        background: linear-gradient(135deg, #eef2ff, #f5f3ff);
        border: 1px solid #dbe2ff;
        border-radius: 28px;
        padding: 28px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
      }

      .newsletter h3 {
        margin: 0 0 8px;
        font-size: clamp(1.7rem, 3vw, 2.5rem);
        letter-spacing: -0.06em;
      }

      .newsletter form {
        display: flex;
        align-items: center;
        gap: 12px;
        width: min(520px, 100%);
      }

      .newsletter input {
        flex: 1;
        min-height: 52px;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0 16px;
        font: inherit;
      }

      footer {
        background: #0f172a;
        color: white;
        padding: 52px 0 28px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr 0.8fr 1fr;
        gap: 28px;
      }

      .footer-brand {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 15px;
      }

      .footer-copy,
      .footer-links a,
      .footer-meta {
        color: rgba(255, 255, 255, 0.7);
      }

      .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 10px;
      }

      .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        margin-top: 32px;
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .otter-corner {
        position: fixed;
        right: 26px;
        top: 110px;
        width: 170px;
        height: 170px;
        z-index: 30;
        pointer-events: none;
        filter: drop-shadow(0 18px 26px rgba(79, 70, 229, 0.14));
      }

      .otter-body {
        position: absolute;
        width: 108px;
        height: 76px;
        background: linear-gradient(135deg, #a8734e, #8b5e3c);
        border-radius: 48% 52% 46% 54% / 58% 55% 45% 42%;
        left: 26px;
        top: 58px;
        border: 3px solid rgba(89, 61, 45, 0.22);
      }

      .otter-head {
        position: absolute;
        width: 76px;
        height: 64px;
        background: linear-gradient(135deg, #b57c52, #965f3d);
        border-radius: 50%;
        left: 78px;
        top: 20px;
        border: 3px solid rgba(89, 61, 45, 0.18);
      }

      .otter-ear {
        position: absolute;
        width: 16px;
        height: 16px;
        background: #7b4f32;
        border-radius: 50%;
        top: 6px;
        border: 2px solid rgba(255,255,255,0.2);
      }

      .otter-ear.left { left: 8px; }
      .otter-ear.right { left: 42px; }

      .otter-face {
        position: absolute;
        width: 42px;
        height: 28px;
        background: #f3d7b5;
        border-radius: 50%;
        left: 16px;
        top: 18px;
      }

      .otter-eye {
        position: absolute;
        width: 6px;
        height: 6px;
        background: #1f2937;
        border-radius: 50%;
        top: 24px;
      }

      .otter-eye.left { left: 22px; }
      .otter-eye.right { left: 34px; }

      .otter-nose {
        position: absolute;
        width: 10px;
        height: 8px;
        background: #5c3f2d;
        border-radius: 50% 50% 60% 60%;
        left: 25px;
        top: 30px;
      }

      .otter-mouth {
        position: absolute;
        width: 18px;
        height: 10px;
        border-bottom: 3px solid #5c3f2d;
        border-radius: 0 0 18px 18px;
        left: 12px;
        top: 35px;
      }

      .otter-arm,
      .otter-leg {
        position: absolute;
        background: linear-gradient(135deg, #9c6d4a, #7b4f32);
        border-radius: 50%;
      }

      .otter-arm {
        width: 22px;
        height: 28px;
        top: 76px;
        border: 2px solid rgba(89, 61, 45, 0.18);
      }

      .otter-arm.left { left: 10px; }
      .otter-arm.right { left: 126px; }

      .otter-leg {
        width: 22px;
        height: 20px;
        top: 112px;
        border: 2px solid rgba(89, 61, 45, 0.18);
      }

      .otter-leg.left { left: 44px; }
      .otter-leg.right { left: 94px; }

      .otter-tail {
        position: absolute;
        width: 52px;
        height: 26px;
        background: linear-gradient(135deg, #7c4d32, #603f2a);
        border-radius: 50% 50% 60% 40%;
        transform: rotate(-30deg);
        left: 6px;
        top: 74px;
        border: 2px solid rgba(89, 61, 45, 0.18);
      }

      .otter-belly {
        position: absolute;
        width: 52px;
        height: 28px;
        background: #e9caa8;
        border-radius: 50%;
        left: 52px;
        top: 78px;
      }

      @media (max-width: 980px) {
        .nav-links {
          display: none;
        }

        .hero-grid,
        .categories,
        .products,
        .footer-grid,
        .testimonials,
        .stats {
          grid-template-columns: 1fr 1fr;
        }

        .hero-grid {
          grid-template-columns: 1fr;
        }

        .deal-banner,
        .newsletter {
          flex-direction: column;
          align-items: flex-start;
        }
      }

      @media (max-width: 640px) {
        .categories,
        .products,
        .stats,
        .testimonials,
        .footer-grid {
          grid-template-columns: 1fr;
        }

        .topbar-inner,
        .nav,
        .section-head,
        .footer-bottom {
          flex-direction: column;
          align-items: flex-start;
        }

        .nav {
          padding: 16px 0;
        }

        .hero {
          padding-top: 28px;
        }

        .hero-actions {
          flex-direction: column;
          align-items: stretch;
        }

        .newsletter form {
          width: 100%;
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <div>Free shipping on orders over $50</div>
        <div class="topbar-links">
          <span>New Arrivals</span>
          <span>Top Deals</span>
          <span>Support</span>
        </div>
      </div>
    </div>

    <header class="header">
      <div class="container nav">
        <div class="brand">
          <div class="brand-mark">S</div>
          <span>SIPT</span>
        </div>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="#home">Home</a>
          <a href="#shop">Shop</a>
          <a href="#deals">Deals</a>
          <a href="#contact">Contact</a>
        </nav>

        <div class="nav-actions">
          <button class="icon-button" aria-label="Cart">🛒</button>
        </div>
      </div>
    </header>

    <main id="home">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="eyebrow">Fresh drop 2026</span>
            <h1>Shop smarter. Live better.</h1>
            <p class="lead">
              Discover premium filtration water bottles engineered to deliver cleaner,
              better-tasting hydration wherever life takes you — built for everyday use,
              superior performance, and a healthier routine.
            </p>

            <div class="hero-actions">
              <a class="primary-btn" href="#shop">Shop now</a>
              <a class="secondary-btn" href="#collections">Explore collections</a>
            </div>

            <div class="hero-meta">
              <div class="hero-stat">
                <strong>20k+</strong>
                <span>Happy shoppers</span>
              </div>
              <div class="hero-stat">
                <strong>48h</strong>
                <span>Fast shipping</span>
              </div>
              <div class="hero-stat">
                <strong>100%</strong>
                <span>Quality promise</span>
              </div>
            </div>
          </div>

          <div class="hero-visual" aria-label="Featured product visuals">
            <div class="phone-card">
              <div class="product-spotlight">
                <div class="spotlight-image">
                  <div class="shoe-illustration"></div>
                </div>
                <div class="spotlight-details">
                  <div>
                    <div class="badge">Best Seller</div>
                    <div style="margin-top: 12px; font-size: 1.3rem; font-weight: 700;">
                      Pulse Runner X
                    </div>
                  </div>
                  <div style="font-size: 1.4rem; font-weight: 800;">$129</div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <section class="section" id="shop">
        <div class="container">
          <div class="section-head">
            <h2>Featured products</h2>
            <a class="ghost-btn" href="#home">More picks</a>
          </div>

          <div class="products">
            <article class="product-card">
              <div class="product-image">
                <span class="tag">Hot</span>
              </div>
              <div class="product-body">
                <div class="rating">★★★★★ 4.9</div>
                <h3 class="product-name">Aero Pro Smartwatch</h3>
                <div class="product-price-row">
                  <div class="price">$199</div>
                  <div class="discount">Save 15%</div>
                </div>
              </div>
            </article>

            <article class="product-card">
              <div class="product-image alt1">
                <span class="tag">New</span>
              </div>
              <div class="product-body">
                <div class="rating">★★★★★ 4.8</div>
                <h3 class="product-name">Summit Travel Pack</h3>
                <div class="product-price-row">
                  <div class="price">$89</div>
                  <div class="discount">Save 10%</div>
                </div>
              </div>
            </article>

            <article class="product-card">
              <div class="product-image alt2">
                <span class="tag">Top Rated</span>
              </div>
              <div class="product-body">
                <div class="rating">★★★★★ 5.0</div>
                <h3 class="product-name">Eco Bottle Pro</h3>
                <div class="product-price-row">
                  <div class="price">$34</div>
                  <div class="discount">Save 20%</div>
                </div>
              </div>
            </article>

